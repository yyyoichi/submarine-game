{
  "$schema": "https://biomejs.dev/schemas/1.8.3/schema.json",
  "organizeImports": {
    "enabled": true
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "ignore": [
      "**/gen/*",
      "**/dist/*",
      "**/node_modules/*"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    },
    "ignore": [
      "**/gen/*",
      "**/dist/*",
      "**/node_modules/*"
    ]
  }
}